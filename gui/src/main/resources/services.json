{
  "services": [
    {
      "name": "hello",
      "command": "echo \"Hello from service\"",
      "windowsCommand": "echo Hello from service",
      "workingDir": ""
    },
    {
      "name": "timer",
      "command": "echo \"Running...\" && echo \"Done!\"",
      "windowsCommand": "echo Running... && echo Done!",
      "workingDir": ""
    },
    {
      "name": "list-files",
      "command": "echo \"Current directory contents:\" && ls -la",
      "windowsCommand": "echo Current directory contents: && dir",
      "workingDir": ""
    },
    {
      "name": "os-check",
      "command": "echo \"Platform: $(uname -o)\" && echo \"Default shell: /bin/sh\"",
      "windowsCommand": "echo Platform: Windows & echo Default shell: cmd.exe",
      "workingDir": ""
    }
  ]
}
