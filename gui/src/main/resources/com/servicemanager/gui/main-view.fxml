<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.servicemanager.gui.controller.MainController">

  <top>
    <MenuBar>
      <Menu text="File">
        <MenuItem text="Exit" onAction="#handleExit"/>
      </Menu>
      <Menu text="Help">
        <MenuItem text="About"/>
      </Menu>
    </MenuBar>
  </top>

  <center>
    <SplitPane dividerPositions="0.7">
      <TableView fx:id="serviceTable">
        <columns>
          <TableColumn text="Name" fx:id="nameColumn" prefWidth="120"/>
          <TableColumn text="Status" fx:id="statusColumn" prefWidth="80"/>
          <TableColumn text="Command" fx:id="commandColumn" prefWidth="250"/>
        </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
      </TableView>

      <VBox spacing="10">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <Button text="Start" onAction="#handleStart" maxWidth="Infinity"/>
        <Button text="Stop" onAction="#handleStop" maxWidth="Infinity"/>
        <Button text="Restart" onAction="#handleRestart" maxWidth="Infinity"/>
        <Button text="Status" onAction="#handleStatus" maxWidth="Infinity"/>
        <Button text="Logs" onAction="#handleLogs" maxWidth="Infinity"/>
        <Button text="Refresh" onAction="#handleRefresh" maxWidth="Infinity"/>
        <Separator/>
        <Label text="Output"/>
        <TextArea fx:id="outputArea" editable="false" VBox.vgrow="ALWAYS"
                  wrapText="true"/>
      </VBox>
    </SplitPane>
  </center>

  <bottom>
    <GridPane hgap="10" vgap="10">
      <padding><Insets bottom="10" left="10" right="10" top="10"/></padding>
      <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
      <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                 promptText="Service name"/>

      <Label text="Command:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
      <TextField fx:id="commandField" GridPane.columnIndex="3" GridPane.rowIndex="0"
                 promptText="Shell command" HBox.hgrow="ALWAYS"/>

      <Label text="Work Dir:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
      <TextField fx:id="workingDirField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                 promptText="(optional)"/>

      <Button text="Create Service" onAction="#handleCreate"
              GridPane.columnIndex="3" GridPane.rowIndex="1"/>
    </GridPane>
  </bottom>
</BorderPane>
