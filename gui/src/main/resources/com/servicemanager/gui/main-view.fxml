<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.web.WebView?>

<BorderPane stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.servicemanager.gui.controller.MainController">

  <top>
    <MenuBar>
      <Menu text="File">
        <MenuItem onAction="#handleExit" text="Exit" />
      </Menu>
      <Menu text="Help">
        <!-- <MenuItem text="Video Tutorial" onAction="#handleVideoTutorial"/> -->
        <MenuItem onAction="#handleDocumentation" text="Documentation" />
        <SeparatorMenuItem />
        <MenuItem onAction="#handleAboutUs" text="About Us" />
      </Menu>
    </MenuBar>
  </top>

  <center>
    <StackPane>
      <!-- Main service management view -->
      <VBox fx:id="mainView">
        <SplitPane dividerPositions="0.7" VBox.vgrow="ALWAYS">
          <TableView fx:id="serviceTable">
            <columns>
              <TableColumn fx:id="nameColumn" prefWidth="120" text="Name" />
              <TableColumn fx:id="statusColumn" prefWidth="80" text="Status" />
              <TableColumn fx:id="commandColumn" prefWidth="250" text="Command" />
            </columns>
            <columnResizePolicy>
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
          </TableView>

          <VBox spacing="10">
            <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
            <Button maxWidth="Infinity" onAction="#handleStart" text="Start" />
            <Button maxWidth="Infinity" onAction="#handleStop" text="Stop" />
            <Button maxWidth="Infinity" onAction="#handleRestart" text="Restart" />
            <Button maxWidth="Infinity" onAction="#handleStatus" text="Status" />
            <Button maxWidth="Infinity" onAction="#handleLogs" text="Logs" />
            <Button maxWidth="Infinity" onAction="#handleRefresh" text="Refresh" />
            <Separator />
            <Label text="Output" />
            <TextArea fx:id="outputArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
          </VBox>
        </SplitPane>

        <GridPane hgap="10" vgap="10">
          <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
          <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
          <TextField fx:id="nameField" promptText="Service name" GridPane.columnIndex="1" GridPane.rowIndex="0" />

          <Label text="Command:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
          <TextField fx:id="commandField" promptText="Shell command" GridPane.columnIndex="3" GridPane.rowIndex="0" HBox.hgrow="ALWAYS" />

          <Label text="Work Dir:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
          <TextField fx:id="workingDirField" promptText="(optional)" GridPane.columnIndex="1" GridPane.rowIndex="1" />

          <Button onAction="#handleCreate" text="Create Service" GridPane.columnIndex="3" GridPane.rowIndex="1" />
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
        </GridPane>
      </VBox>

      <!-- About Us pane (hidden by default) -->
      <VBox fx:id="aboutPane" managed="false" visible="false" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
          <Button onAction="#handleBackToMain" style="-fx-cursor: hand; -fx-font-size: 13;" text="← Back" />
        </HBox>

        <HBox alignment="CENTER" spacing="0" VBox.vgrow="ALWAYS">
          <!-- Semion Section (Left) -->
          <VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="14" style="-fx-background-color: #FAEBD7; -fx-padding: 25 20 25 20;" HBox.hgrow="ALWAYS">

            <StackPane>
              <Rectangle ArcHeight="12" ArcWidth="12" fill="#A8D8EA" height="444.0" style="-fx-stroke: #8B7355; -fx-stroke-width: 3;" width="200.0">
                <effect>
                  <DropShadow color="#00000044" offsetX="2" offsetY="2" radius="3" />
                </effect>
              </Rectangle>
              <Text fill="white" style="-fx-font-weight: bold; -fx-font-size: 28;                            -fx-font-family: 'Segoe UI', sans-serif;" text="SA" />
            </StackPane>

            <HBox alignment="CENTER" spacing="20">
              <Hyperlink onAction="#openSemionGitHub" text="GitHub">
                <graphic>
                  <Rectangle ArcHeight="3" ArcWidth="3" fill="#333333" height="14" width="14" />
                </graphic>
              </Hyperlink>
              <Hyperlink onAction="#openSemionLinkedIn" text="LinkedIn">
                <graphic>
                  <Rectangle ArcHeight="3" ArcWidth="3" fill="#0A66C2" height="14" width="14" />
                </graphic>
              </Hyperlink>
            </HBox>

            <VBox alignment="TOP_LEFT" maxWidth="280" spacing="6">
              <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="About me:" />
              <Label style="-fx-text-fill: #555; -fx-font-size: 12;" text="(Add your description here)" wrapText="true" />

              <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="My contribution:" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="0" left="0" right="0" top="10" /></padding>
              </Label>
              <Label style="-fx-text-fill: #555; -fx-font-size: 12;" text="(Describe your contributions here)" wrapText="true" />
            </VBox>
          </VBox>

          <!-- Vertical Divider -->
          <Separator orientation="VERTICAL" prefWidth="2" style="-fx-background-color: #A0926B;" />

          <!-- Raheem Section (Right) -->
          <VBox alignment="TOP_CENTER" maxWidth="Infinity" spacing="14" style="-fx-background-color: #F5F5DC; -fx-padding: 25 20 25 20;" HBox.hgrow="ALWAYS">

            <StackPane>
              <Rectangle ArcHeight="12" ArcWidth="12" fill="#A8E6CF" height="444" style="-fx-stroke: #6B8E23; -fx-stroke-width: 3;" width="200">
                <effect>
                  <DropShadow color="#00000044" offsetX="2" offsetY="2" radius="3" />
                </effect>
              </Rectangle>
              <Text fill="white" style="-fx-font-weight: bold; -fx-font-size: 28;                            -fx-font-family: 'Segoe UI', sans-serif;" text="RK" />
            </StackPane>

            <HBox alignment="CENTER" spacing="20">
              <Hyperlink onAction="#openRaheemGitHub" text="GitHub">
                <graphic>
                  <Rectangle ArcHeight="3" ArcWidth="3" fill="#333333" height="14" width="14" />
                </graphic>
              </Hyperlink>
              <Hyperlink onAction="#openRaheemLinkedIn" text="LinkedIn">
                <graphic>
                  <Rectangle ArcHeight="3" ArcWidth="3" fill="#0A66C2" height="14" width="14" />
                </graphic>
              </Hyperlink>
            </HBox>

            <VBox alignment="TOP_LEFT" maxWidth="280" spacing="6">
              <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="About me:" />
              <Label style="-fx-text-fill: #555; -fx-font-size: 12;" text="(Add your description here)" wrapText="true" />

              <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="My contribution:" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="0" left="0" right="0" top="10" /></padding>
              </Label>
              <Label style="-fx-text-fill: #555; -fx-font-size: 12;" text="(Describe your contributions here)" wrapText="true" />
            </VBox>
          </VBox>
        </HBox>
      </VBox>

      <!-- Documentation pane (hidden by default) -->
      <VBox fx:id="docPane" visible="false" managed="false" VBox.vgrow="ALWAYS"
            style="-fx-background-color: #f4f6f8;">
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f4f6f8;">
          <Button text="← Back" onAction="#handleBackToMain"
                  style="-fx-cursor: hand; -fx-font-size: 13;"/>
        </HBox>
        <WebView fx:id="docWebView" VBox.vgrow="ALWAYS"/>
      </VBox>
    </StackPane>
  </center>
</BorderPane>
